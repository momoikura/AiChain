# ---------------------------------------------------------------------------
# Crypto Sentinel AI — environment
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# The app runs in "preview mode" (no auth/persistence) until the two public
# Supabase vars are set.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Supabase → Project Settings → API → service_role secret.
# NEVER expose this to the browser. Optional (only used by the admin client).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 32+ char secret used to encrypt exchange API keys (AES-256-GCM) at rest.
# Generate: `openssl rand -hex 32`  — changing it invalidates stored keys.
APIKEY_ENC_SECRET=change-me-to-a-long-random-string
