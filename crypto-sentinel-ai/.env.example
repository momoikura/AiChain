# ---------------------------------------------------------------------------
# Crypto Sentinel AI — environment TEMPLATE (committed — placeholders ONLY)
#
# ⚠️  NEVER put real keys in this file. It is tracked by git.
# Copy to `.env.local` (gitignored) for local dev, and set the same vars in
# Vercel → Project Settings → Environment Variables for production.
# The app runs in "preview mode" until the two public Supabase vars are set.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API. Use the BASE project URL (no path suffix).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Supabase → Project Settings → API → service_role secret.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 32+ char random secret to encrypt exchange API keys (AES-256-GCM) at rest.
# Generate: `openssl rand -hex 32`  — changing it invalidates stored keys.
APIKEY_ENC_SECRET=change-me-to-a-long-random-string
